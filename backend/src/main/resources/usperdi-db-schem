-- PostgreSQL database dump

SET statement_timeout = 0;
SET lock_timeout = 0;
SET idle_in_transaction_session_timeout = 0;
SET transaction_timeout = 0;
SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;
SELECT pg_catalog.set_config('search_path', '', false);
SET check_function_bodies = false;
SET xmloption = content;
SET client_min_messages = warning;
SET row_security = off;

-- ENUMS
CREATE TYPE public.campus_enum AS ENUM (
    'sp-butanta', 'sp-centro', 'sp-quadrilatero', 'sp-leste',
    'piracicaba', 'sao-carlos', 'ribeirao-preto', 'lorena',
    'bauru', 'pirassununga', 'santos', 'outro'
);
ALTER TYPE public.campus_enum OWNER TO postgres;

CREATE TYPE public.status_conta_enum AS ENUM (
    'ativa', 'banida', 'suspensa', 'inativa'
);
ALTER TYPE public.status_conta_enum OWNER TO postgres;

CREATE TYPE public.status_denuncia_enum AS ENUM (
    'pendente', 'aceita', 'rejeitada'
);
ALTER TYPE public.status_denuncia_enum OWNER TO postgres;

CREATE TYPE public.status_item_enum AS ENUM (
    'perdido', 'encontrado', 'recuperado'
);
ALTER TYPE public.status_item_enum OWNER TO postgres;

SET default_tablespace = '';
SET default_table_access_method = heap;

-- TABLE: denuncia
CREATE TABLE public.denuncia (
    id bigint NOT NULL,
    descricao text NOT NULL,
    data timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    status public.status_denuncia_enum DEFAULT 'pendente'::public.status_denuncia_enum NOT NULL,
    id_denunciado bigint NOT NULL,
    id_denunciante bigint NOT NULL
);
ALTER TABLE public.denuncia OWNER TO postgres;
ALTER TABLE public.denuncia ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.denuncia_id_seq START WITH 1 INCREMENT BY 1 NO MINVALUE NO MAXVALUE CACHE 1
);

-- TABLE: item
CREATE TABLE public.item (
    id bigint NOT NULL,
    nome character varying(100) NOT NULL,
    foto text NOT NULL,
    local character varying(150),
    status public.status_item_enum NOT NULL,
    descricao text,
    tipo character varying(50) NOT NULL,
    data_registro timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    data_ocorrencia date,
    usuario_id bigint NOT NULL
);
ALTER TABLE public.item OWNER TO postgres;
ALTER TABLE public.item ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.item_id_seq START WITH 1 INCREMENT BY 1 NO MINVALUE NO MAXVALUE CACHE 1
);

-- TABLE: recupera
CREATE TABLE public.recupera (
    item_id bigint NOT NULL,
    usuario_id bigint NOT NULL,
    data date NOT NULL,
    observacao text
);
ALTER TABLE public.recupera OWNER TO postgres;

-- TABLE: usuario (SENHA REMOVIDA)
CREATE TABLE public.usuario (
    id bigint NOT NULL,
    nome character varying(100) NOT NULL,
    email_usp character varying(100) NOT NULL,
    telefone character varying(20),
    campus public.campus_enum,
    status_da_conta public.status_conta_enum DEFAULT 'ativa'::public.status_conta_enum,
    foto text,
    data_cadastro timestamp without time zone DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE public.usuario OWNER TO postgres;
ALTER TABLE public.usuario ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.usuario_id_seq START WITH 1 INCREMENT BY 1 NO MINVALUE NO MAXVALUE CACHE 1
);

-- RESET SEQUENCES
SELECT pg_catalog.setval('public.denuncia_id_seq', 1, false);
SELECT pg_catalog.setval('public.item_id_seq', 1, false);
SELECT pg_catalog.setval('public.usuario_id_seq', 1, false);

-- PRIMARY KEYS & UNIQUE
ALTER TABLE ONLY public.denuncia ADD CONSTRAINT pk_denuncia PRIMARY KEY (id);
ALTER TABLE ONLY public.item ADD CONSTRAINT pk_item PRIMARY KEY (id);
ALTER TABLE ONLY public.recupera ADD CONSTRAINT pk_recupera PRIMARY KEY (item_id, usuario_id);
ALTER TABLE ONLY public.usuario ADD CONSTRAINT pk_usuario PRIMARY KEY (id);
ALTER TABLE ONLY public.usuario ADD CONSTRAINT usuario_email_usp_key UNIQUE (email_usp);

-- FOREIGN KEYS COM CASCATAS
ALTER TABLE ONLY public.denuncia
    ADD CONSTRAINT fk_denuncia_id_denunciado FOREIGN KEY (id_denunciado) REFERENCES public.usuario(id) ON UPDATE CASCADE ON DELETE CASCADE;

ALTER TABLE ONLY public.denuncia
    ADD CONSTRAINT fk_denuncia_id_denunciante FOREIGN KEY (id_denunciante) REFERENCES public.usuario(id) ON UPDATE CASCADE ON DELETE CASCADE;

ALTER TABLE ONLY public.item
    ADD CONSTRAINT fk_item_usuario_id FOREIGN KEY (usuario_id) REFERENCES public.usuario(id) ON UPDATE CASCADE ON DELETE CASCADE;

ALTER TABLE ONLY public.recupera
    ADD CONSTRAINT fk_recupera_item_id FOREIGN KEY (item_id) REFERENCES public.item(id) ON UPDATE CASCADE ON DELETE CASCADE;

ALTER TABLE ONLY public.recupera
    ADD CONSTRAINT fk_recupera_usuario_id FOREIGN KEY (usuario_id) REFERENCES public.usuario(id) ON UPDATE CASCADE ON DELETE CASCADE;